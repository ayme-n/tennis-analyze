# ---------------------------------------------------------------------------
# Tennis Match Prep — server-side configuration. Copy to .env.local.
# NEVER commit the real .env.local and NEVER expose these values to the browser
# (no NEXT_PUBLIC_ prefix on anything sensitive).
# ---------------------------------------------------------------------------

# Sportradar Tennis API key (trial keys are free: https://marketplace.sportradar.com/signup
# -> add the "Tennis" trial). Without a key the app starts but shows
# "Data provider not connected" and never fabricates data.
SPORTRADAR_API_KEY=

# Access level of your key: "trial" (default) or "production".
SPORTRADAR_ACCESS_LEVEL=trial

# Optional overrides for the provider base URL and language code.
# SPORTRADAR_BASE_URL=https://api.sportradar.com/tennis
# SPORTRADAR_LANGUAGE=en

# Throttle: minimum milliseconds between provider requests (trial-friendly).
# PROVIDER_MIN_INTERVAL_MS=1100
# Per-request timeout in milliseconds.
# PROVIDER_TIMEOUT_MS=12000

# Extra players to merge into the search directory (comma-separated Sportradar
# competitor IDs) for players outside the ranking feeds.
# EXTRA_PLAYER_IDS=sr:competitor:12345,sr:competitor:67890
